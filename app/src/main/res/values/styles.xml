<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_amber_dim</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">@color/accent_amber_dim</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="AmberSlider" parent="Widget.MaterialComponents.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="trackColorActive">@color/accent_amber</item>
        <item name="trackColorInactive">@color/surface</item>
        <item name="thumbColor">@color/accent_amber</item>
        <item name="haloColor">@color/accent_amber_dim</item>
    </style>
</resources>
